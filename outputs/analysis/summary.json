  "figures": [
    {
      "name": "medical_objective",
      "path": "outputs/figures/medical_objective.png",
      "caption": "Cada ponto representa uma semente; as linhas são os comparadores. A dispersão e resultados piores são preservados. J combina distância e chegada ponderada; não é apenas quilômetros.",
      "sha256": "08fa8003a79c672dc9718ad31d4fd3a781e67c814fe2c317a785ab8abaf568ef"
    },
    {
      "name": "benchmark_gap",
      "path": "outputs/figures/benchmark_gap.png",
      "caption": "O gap usa o custo publicado e a distância EUC_2D original. Não se convertem essas unidades em quilômetros nem se incluem prioridades médicas.",
      "sha256": "8c31c74ad5930a2c60e8a2342af6616e6ebfe93bbae9c1044301811da7eba5da"
    },
    {
      "name": "runtime_critical",
      "path": "outputs/figures/runtime_critical.png",
      "caption": "O GA tem teto de fitness e tentativas; OR-Tools tem cinco segundos. As curvas de tempo não demonstram igualdade de orçamento. Chegadas são minutos após a saída de cada veículo.",
      "sha256": "51309ff591a34782ab4b9d6359ab13b8cde9afba494578b70511bed13feb79b4"
    },
    {
      "name": "convergence",
      "path": "outputs/figures/convergence.png",
      "caption": "Linhas representam evolução registrada; marcadores mostram observações inicial/final sem gerações. Círculo, quadrado e cruz distinguem resultados sobrepostos, sem deslocar seus valores. Inicialização interrompida não comprova convergência.",
      "sha256": "93b6fa568c0ff3329930d98cb3f2f50bd3898223a74daaad25b7f3784dad6e7a"
    },
    {
      "name": "priority_sensitivity",
      "path": "outputs/figures/priority_sensitivity.png",
      "caption": "Sensibilidade exploratória de uma semente e um cenário de 30 entregas. Não estima causalidade nem estabelece pesos clínicos; os valores são premissas de modelagem.",
      "sha256": "a45fcddc5101c3b3bbfac5c06475b5961f5d9b2939bcb6f503e80389c57deb27"
    },
    {
      "name": "weekly_distance",
      "path": "outputs/figures/weekly_distance.png",
      "caption": "Sete cenários fictícios de 12 entregas. A variação resulta das localizações, cargas e prioridades sorteadas; não representa histórico operacional de hospitais.",
      "sha256": "60914ad8536b9e80f63b452489fe7a96f1a53caf449f2a0f62b232ccec2a1ba0"
    },
    {
      "name": "fiap_tsp",
